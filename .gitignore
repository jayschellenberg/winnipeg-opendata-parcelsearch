# Large local data downloads (regenerated by r/download_parcels.R)
*.gpkg
*.geojson
ParcelCrossRef_*.csv

# Exception: the static map-overlay GeoJSON files under web/public/
# are generated by `npm run refresh:*` scripts and need to be
# committed so Vercel deploys ship them. They're small (each ~100 KB
# to a few MB).
!web/public/transit-*.geojson
!web/public/wpg-neighbourhood*.geojson

# Web build outputs
web/node_modules/
web/dist/

# Editor / Vite scratch files (created during dev, not part of the source)
*.tmp.*
vite.config.*.timestamp-*.mjs

# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS
.DS_Store
Thumbs.db

