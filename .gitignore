# Large local data downloads (regenerated by r/download_parcels.R)
*.gpkg
*.geojson
ParcelCrossRef_*.csv
AssessmentParcels_*.csv

# Exception: the transit overlays under web/public are static
# assets generated by `npm run refresh:transit` and need to be
# committed so deploys ship them.
!web/public/transit-*.geojson
!web/public/wpg-neighbourhood*.geojson

# Web build outputs
web/node_modules/
web/dist/

# Citywide-parcels tile archive: too big for git (96 MB, and a rebuild used
# to add ~80 MB of history every time). The deployed copy is fetched from
# the `parcels-pmtiles` GitHub release in vercel.json's buildCommand; keep
# a local copy here for dev. Publish a rebuild with (from the repo root):
#   powershell -ExecutionPolicy Bypass -File r\rebuild_tiles.ps1
# Do NOT publish with `gh release upload --clobber`: it deletes the live
# asset before uploading, so a failed upload leaves the release empty and
# every deploy silently loses the overlay. That is the 2026-08-05 outage.
web/public/parcels.pmtiles

# Editor / Vite scratch files (created during dev, not part of the source)
*.tmp.*
vite.config.*.timestamp-*.mjs

# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS
.DS_Store
Thumbs.db

# Claude Code local dev config
.claude/
.positai

# Tile-build intermediates. tippecanoe writes here and build_parcel_tiles.R
# promotes over parcels.pmtiles on success; a build interrupted midway would
# otherwise leave a ~100 MB untracked file that a `git add -A` could stage.
web/public/parcels.tmpbuild.pmtiles*

# Python bytecode from tools/
__pycache__/
*.pyc
