# Large local data downloads (regenerated by r/download_parcels.R)
*.gpkg
*.geojson
ParcelCrossRef_*.csv
AssessmentParcels_*.csv

# Exception: the transit overlays under web/public are static
# assets generated by `npm run refresh:transit` and need to be
# committed so deploys ship them.
!web/public/transit-*.geojson
!web/public/wpg-neighbourhood*.geojson

# Web build outputs
web/node_modules/
web/dist/

# Citywide-parcels tile archive: too big for git (82 MB, and a rebuild used
# to add ~80 MB of history every time). The deployed copy is fetched from
# the `parcels-pmtiles` GitHub release in vercel.json's buildCommand; keep
# a local copy here for dev. Publish a rebuild with:
#   gh release upload parcels-pmtiles web/public/parcels.pmtiles --clobber
web/public/parcels.pmtiles

# Editor / Vite scratch files (created during dev, not part of the source)
*.tmp.*
vite.config.*.timestamp-*.mjs

# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS
.DS_Store
Thumbs.db

# Claude Code local dev config
.claude/
.positai
